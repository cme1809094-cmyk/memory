{
  "name": "memory-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A local knowledge base for Windows",
  "author": "Memory contributors",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test test/*.test.cjs",
    "dist:win": "electron-builder --win nsis --x64",
    "test:desktop": "node test/desktop-smoke.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "lucide": "npm:lucide-static@^0.577.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "playwright": "^1.60.0"
  },
  "build": {
    "appId": "app.memory.desktop",
    "productName": "Memory",
    "files": [
      "src/**/*",
      "package.json",
      "!**/4.0.0/**"
    ],
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@tesseract.js-data/**",
      "node_modules/bmp-js/**",
      "node_modules/idb-keyval/**",
      "node_modules/is-url/**",
      "node_modules/node-fetch/**",
      "node_modules/whatwg-url/**",
      "node_modules/webidl-conversions/**",
      "node_modules/tr46/**",
      "node_modules/regenerator-runtime/**",
      "node_modules/wasm-feature-detect/**",
      "node_modules/zlibjs/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ]
    },
    "artifactName": "Memory-Setup-${version}-${arch}.${ext}"
  }
}
